    "blockLibrary.bodyGrounding.cue1": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notice where your feet meet the floor and your back meets the surface behind you."
          }
        }
      }
    },
    "blockLibrary.bodyGrounding.cue2": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Come to your shoulders. If they're raised, let them drop; if they won't, don't force it — noticing is enough."
          }
        }
      }
    },
    "blockLibrary.bodyGrounding.cue3": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your jaw and forehead. If they are tight, let them soften."
          }
        }
      }
    },
    "blockLibrary.bodyGrounding.cue4": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a moment, feel your body as a whole. There's nothing you need to fix."
          }
        }
      }
    },
    "blockLibrary.bodyGrounding.title": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Returning to the body"
          }
        }
      }
    },
    "blockLibrary.breathAwareness.cue1": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Settle in where you're sitting or lying down. If you'd like to close your eyes, you can; otherwise, rest your gaze on one point."
          }
        }
      }
    },
    "blockLibrary.breathAwareness.cue2": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There's no need to change your breath. Just notice where it passes through — your nose, or your chest."
          }
        }
      }
    },
    "blockLibrary.breathAwareness.cue3": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now follow the movement on the screen. Breathe in as it opens, and breathe out as it draws in."
          }
        }
      }
    },
    "blockLibrary.breathAwareness.cue4": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the out-breath take a little longer. There is no hurry; the breath finds its own pace."
          }
        }
      }
    },
    "blockLibrary.breathAwareness.title": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Noticing the breath"
          }
        }
      }
    },
    "blockLibrary.reflectionNotice.cue1": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give a name to whatever is inside right now. Tension, tiredness, restlessness — whichever it is."
          }
        }
      }
    },
    "blockLibrary.reflectionNotice.cue2": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't try to change what you've named. Noticing is enough for today."
          }
        }
      }
    },
    "blockLibrary.reflectionNotice.cue3": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your attention has wandered, that's fine — wandering is normal. Come back to the breath."
          }
        }
      }
    },
    "blockLibrary.reflectionNotice.title": {
      "extractionState": "manual",
      "comment": "BlockLibrary.swift",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Naming what you notice"
          }
        }
      }
    },
