{
  "sourceLanguage": "en",
  "strings": {
    "discover.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Keşfet"
          }
        }
      }
    },
    "discover.headline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little space\nfor yourself."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendine küçük\nbir alan."
          }
        }
      }
    },
    "discover.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Small practices. A path you can make time for."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük pratikler. Yer açabileceğin bir patika."
          }
        }
      }
    },
    "discover.personalEyebrow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MADE FOR YOU"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SANA ÖZEL"
          }
        }
      }
    },
    "discover.personalTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your own path\nstarts with you."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana ait bir yol\nseninle başlar."
          }
        }
      }
    },
    "discover.personalBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your words, your pace. A path shaped around what you shared."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Senin kelimelerin, senin ritmin. Paylaştıklarınla şekillenen bir yol."
          }
        }
      }
    },
    "discover.personalAction": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to my path"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikama dön"
          }
        }
      }
    },
    "discover.personalConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Return to your personal path?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kişisel patikana dönmek ister misin?"
          }
        }
      }
    },
    "discover.personalConfirmBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress in prepared paths stays on this device. If you do not have a personal path yet, you can create one there."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır patikalardaki ilerlemen bu cihazda kalır. Henüz kişisel bir patikan yoksa orada oluşturabilirsin."
          }
        }
      }
    },
    "discover.cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not now"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şimdilik değil"
          }
        }
      }
    },
    "discover.collection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a small beginning"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Küçük bir başlangıç seç"
          }
        }
      }
    },
    "discover.collectionNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepared paths · English audio · Two voices"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır patikalar · İngilizce ses · İki anlatıcı"
          }
        }
      }
    },
    "discover.preview": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preview"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önizleme"
          }
        }
      }
    },
    "discover.previewNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are previewing this path. Join before starting a session."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu patikayı önizliyorsun. Oturum başlatmak için önce katıl."
          }
        }
      }
    },
    "discover.join": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join this path"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu patikaya katıl"
          }
        }
      }
    },
    "discover.joinTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this your current path?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, mevcut patikan olsun mu?"
          }
        }
      }
    },
    "discover.joinBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your other paths keep their progress. These sessions are prepared, not personalized. Progress is saved on this device."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer patikaların ilerlemesi korunur. Bu oturumlar hazır içeriktir, kişiselleştirilmez. İlerlemen bu cihazda saklanır."
          }
        }
      }
    },
    "discover.voice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose your guide"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana eşlik edecek sesi seç"
          }
        }
      }
    },
    "discover.voiceNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both narrators guide the same practice in English. You can change voices between sessions."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki anlatıcı da aynı pratiği İngilizce sunar. Oturumlar arasında sesi değiştirebilirsin."
          }
        }
      }
    },
    "discover.feminine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Female voice"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadın sesi"
          }
        }
      }
    },
    "discover.masculine": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Male voice"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkek sesi"
          }
        }
      }
    },
    "discover.steps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Along this path"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu patikada"
          }
        }
      }
    },
    "discover.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin session"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu başlat"
          }
        }
      }
    },
    "discover.replay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden dinle"
          }
        }
      }
    },
    "discover.nextLocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available after the previous step"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki adımdan sonra açılır"
          }
        }
      }
    },
    "discover.continuePath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue this path"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu patikaya devam et"
          }
        }
      }
    },
    "discover.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready when you are"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır olduğunda burada"
          }
        }
      }
    },
    "discover.completed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This step is complete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu adım tamamlandı."
          }
        }
      }
    },
    "discover.completedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can leave it here. Your next step will be waiting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada durabilirsin. Sıradaki adımın seni bekler."
          }
        }
      }
    },
    "discover.close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close session"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumu kapat"
          }
        }
      }
    },
    "discover.backToPath": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back to path"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikaya dön"
          }
        }
      }
    },
    "discover.quiet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay with the practice. Breathe naturally."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratikle kal. Doğal nefesini sürdür."
          }
        }
      }
    },
    "discover.loading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Getting your session ready…"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun hazırlanıyor…"
          }
        }
      }
    },
    "discover.audioUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This recording could not open. Your progress is unchanged."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kayıt açılamadı. İlerlemen değişmedi."
          }
        }
      }
    },
    "discover.retry": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden dene"
          }
        }
      }
    },
    "discover.catalogError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The paths could not open. Please reopen the app. Your progress has not been removed."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patikalar açılamadı. Uygulamayı yeniden açabilirsin. İlerlemen silinmedi."
          }
        }
      }
    },
    "discover.audioPreparing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is not available in this build."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sürümde sesler kullanıma hazır değil."
          }
        }
      }
    },
    "discover.duration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "7 steps · About 2 min each"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "7 adım · Her biri yaklaşık 2 dk"
          }
        }
      }
    },
    "discover.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Included audio · Works offline"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesler dahil · Çevrimdışı çalışır"
          }
        }
      }
    },
    "discover.done": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Completed"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlandı"
          }
        }
      }
    },
    "discover.now": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your next step"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki adımın"
          }
        }
      }
    },
    "discover.allDone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You reached the end of this path."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu patikanın sonuna geldin."
          }
        }
      }
    },
    "discover.allDoneBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can return to any of these practices whenever you choose."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin zaman bu pratiklerden birine dönebilirsin."
          }
        }
      }
    },
    "discover.saveError": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your progress could not be saved. Please keep this screen open and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlerlemen kaydedilemedi. Bu ekranı açık tutup yeniden deneyebilirsin."
          }
        }
      }
    },
    "discover.pause": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Duraklat"
          }
        }
      }
    },
    "discover.resume": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resume"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürdür"
          }
        }
      }
    }
  },
  "version": "1.0"
}
