{
  "sourceLanguage": "tr",
  "version": "1.0",
  "strings": {
    "support.title": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Destek al"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get support"
          }
        }
      }
    },
    "support.body": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an zorlanıyorsan bununla yalnız kalmak zorunda değilsin. Aşağıdaki hatlarda seni dinleyecek biri var."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you're struggling right now, you don't have to be alone with it. There are people on the lines below who will listen."
          }
        }
      }
    },
    "support.call": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Call"
          }
        }
      }
    },
    "support.tapToCall": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aramak için dokun."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to call."
          }
        }
      }
    },
    "support.directory": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bulunduğun ülkedeki diğer hatlar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Other helplines in your country"
          }
        }
      }
    },
    "support.notEmergencyService": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Patika bir acil durum ya da tedavi hizmeti değildir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Patika is not an emergency or treatment service."
          }
        }
      }
    },
    "support.emergency.name": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acil çağrı"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency call"
          }
        }
      }
    },
    "support.emergency.detail": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen ya da bir başkası hemen tehlikedeyse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you or someone else is in immediate danger"
          }
        }
      }
    },
